# M2 Sentiment Engine — LLM API 配置
# 拷贝本文件为 .env(已 gitignore,不会进仓库),填上真实值

# OpenAI 兼容 API 的 base URL(例如小米 Token Plan / SiliconFlow / OpenRouter / 自建网关)
# 必填,缺失时 SentimentEngine 在调用时会直接 raise
LLM_BASE_URL=https://your-llm-gateway.example.com/v1

# API key
LLM_API_KEY=sk-your-key-here

# 模型名(可选,缺省 mimo-v2.5-pro)
# LLM_MODEL=mimo-v2.5-pro
